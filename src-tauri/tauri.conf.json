{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Macally Studio",
  "version": "1.3.0",
  "identifier": "com.tyronemadison.macallystudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Macally Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 1100,
        "minHeight": 720,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DATA/Macally Studio/icons/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxRjg1MTc5ODgyOEIzRTgKUldUb3N5aUllVkg0WVd3TXIrOHBVVzkzbVhMZzBGeGJxSmpuUEd5ZGJRL1U2ZVZJOE1HSXhCYVoK",
      "endpoints": [
        "https://github.com/TyroneMadison/Macally-Studio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
